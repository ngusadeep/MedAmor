# MedAudit - Root env for Docker Compose
# Copy to .env and set values. Used by docker-compose and backend.

# ------------------------------------------
# PostgreSQL (required for backend)
# ------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=medaudit
POSTGRES_PORT=5432

# ------------------------------------------
# Nginx
# ------------------------------------------
NGINX_PORT=80

# ------------------------------------------
# Backend (overrides in container)
# ------------------------------------------
# DATABASE_URL is built from POSTGRES_* in docker-compose; override here if needed
# EHR_DATA_ROOT is set to /data in compose (project root is mounted at /data)
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1,http://127.0.0.1:80
ENVIRONMENT=production
DEBUG=false

# ------------------------------------------
# Frontend build args (VITE_*)
# ------------------------------------------
VITE_API_URL=/api
VITE_BASENAME=
VITE_GTM_ID=
