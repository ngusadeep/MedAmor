# MedAudit - Single env for all projects (backend, frontend, Docker)
# Copy to .env and set values. Backend and frontend load from this file at repo root.

# ------------------------------------------
# PostgreSQL
# ------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=medaudit
POSTGRES_PORT=5432

# For local backend (without Docker), use this or leave default
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medaudit

# ------------------------------------------
# Nginx (Docker)
# ------------------------------------------
NGINX_PORT=80

# ------------------------------------------
# Backend
# ------------------------------------------
HOST=0.0.0.0
PORT=8000
# Path to folder containing EHR-DATA_* dirs. In Docker set to /data; leave unset for local default.
# EHR_DATA_ROOT=/path/to/MedAudit
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80,http://127.0.0.1:80
ENVIRONMENT=development
DEBUG=true

# ------------------------------------------
# RabbitMQ (Celery) — or use Redis section below for CELERY_BROKER_URL
# ------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ------------------------------------------
# ChromaDB (vector DB for RAG)
# ------------------------------------------
CHROMA_PERSIST_DIR=./chroma_data

# Embedding: fastembed (default) or openai (requires OPENAI_API_KEY)
EMBEDDING_PROVIDER=fastembed
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------
# Redis (optional; use for Celery broker instead of RabbitMQ)
# ------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------------
# Auth (JWT)
# ------------------------------------------
JWT_SECRET_KEY=change_me_jwt_secret_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ------------------------------------------
# AI / RAG (Phase 2+)
# ------------------------------------------
# HF_TOKEN=your_huggingface_token_for_medgemma
# HF_MEDGEMMA_ENDPOINT=https://api-inference.huggingface.co/...  # HF Inference endpoint URL
# LANGCHAIN_API_KEY=  # LangSmith (optional)
# OPENAI_API_KEY=    # Set above for OpenAI embeddings (text-embedding-3-small)

# ------------------------------------------
# Frontend (VITE_*)
# ------------------------------------------
VITE_API_URL=/api
VITE_BASENAME=
VITE_GTM_ID=
