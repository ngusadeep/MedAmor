# ==========================================
# MONOREPO .GITIGNORE - CLEAN & PRACTICAL
# ==========================================
# No redundancies: Directory-aware where needed, global where safe

# ==========================================
# PLATFORM-SPECIFIC PATTERNS
# ==========================================
# Platform UI (React/TypeScript)
platform/ui/node_modules/
platform/ui/dist/
platform/ui/build/
platform/ui/.cache/
platform/ui/.parcel-cache/
platform/ui/coverage/
platform/ui/*.log
platform/ui/npm-debug.log*
platform/ui/yarn-debug.log*
platform/ui/yarn-error.log*

# Platform Backend (Python)
platform/.venv/
platform/venv/
platform/env/
platform/__pycache__/
platform/*.pyc
platform/*.pyo
platform/.pytest_cache/
platform/.coverage
platform/htmlcov/
platform/.mypy_cache/
platform/.ruff_cache/
platform/instance/
platform/webassets-cache
platform/db.sqlite3
platform/db.sqlite3-journal
platform/*.log

# Platform Docker and deployment
platform/nginx/logs/
platform/nginx/temp/
platform/logs/
platform/*.pid
platform/.env.local
platform/.env.production

# Platform IDE and tools
platform/.vscode/
platform/.idea/
platform/*.swp
platform/*.swo
platform/*~

# ==========================================
# DIRECTORY-SPECIFIC PATTERNS (only in named directories)
# ==========================================
# Frontend dependencies and build outputs
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.next/
frontend/out/
frontend/coverage/

# Backend virtual environments and artifacts
backend/__pycache__/
backend/.venv/
backend/venv/
backend/.coverage
backend/htmlcov/
backend/dist/
backend/build/

# ==========================================
# GLOBAL PATTERNS (apply everywhere - no directory prefix needed)
# ==========================================
# OS and system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.spyderproject
.spyproject
.ropeproject

# Security: Environment files (ignore everywhere)
.env
.env.prod
.envrc
.env.development.local
.env.test.local
.env.production.local
.env.local

# Logs and temporary files
*.log
logs/
*.tmp
*.temp
*.pid
*.seed

# Python bytecode (safe to ignore globally in Python projects)
*.py[codz]
*$py.class
*.so

# Build and packaging artifacts
*.manifest
*.spec
*.egg-info/
.eggs/

# Database files
*.sqlite3
*.db
*.sqlite

# ==========================================
# FRAMEWORK PATTERNS (technology-specific, no conflicts)
# ==========================================
# Node.js ecosystem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache
.stylelintcache
.parcel-cache
.nuxt
.docusaurus

# Python ecosystem
.pytest_cache/
.mypy_cache/
.dmypy.json
.pyre/
.pytype/
.ruff_cache/
__pypackages__/
celerybeat-schedule
celerybeat.pid

# Documentation and tools
docs/_build/
/site
.pybuilder/
target/
.abstra/
.cursorignore
.cursorindexingignore
marimo/_static/
marimo/_lsp/
__marimo__/

# Frontend (Node.js/JavaScript)
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
public

# Vuepress build output
.vuepress/dist

# Vuepress v2.x temp and cache directory
.temp
.cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# React Native
.expo
.expo-shared

# Backend (Python) - Additional patterns for monorepo
# Virtual environments
.venv/
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs/
*.log

# Database
*.sqlite3
*.db
*.sqlite

# Temporary files
*.tmp
*.temp
