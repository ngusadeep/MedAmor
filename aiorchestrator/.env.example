# Google API Key for Gemini and Embeddings
GOOGLE_API_KEY=your_google_api_key_here

# Gemini Model Selection
# Options: gemini-2.0-flash-exp (fast, cost-effective), gemini-3-pro (advanced reasoning)
GEMINI_MODEL=gemini-2.0-flash-exp

# HAPI FHIR Server URL (local Docker)
HAPI_FHIR_URL=http://localhost:9080/fhir

# ChromaDB Configuration
CHROMA_PERSIST_DIR=./chroma_data

# Medical Knowledge Base Path (relative to project root)
MEDICAL_KB_PATH=../docs/Medical_KB

# Use dummy FHIR data for testing (set to false to use real HAPI FHIR server)
USE_DUMMY_FHIR=false

# Redis URL for Celery task queue
REDIS_URL=redis://localhost:6379/0
