# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=8000
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medaudit

# EHR mock data root (path to folder containing EHR-DATA_* directories; default: project root)
# EHR_DATA_ROOT=/path/to/MedAudit

# Redis (for Celery; optional in Phase 1)
# REDIS_URL=redis://localhost:6379

# API Keys (Phase 2+)
# OPENAI_API_KEY=your_openai_key_here
# HF_TOKEN=your_huggingface_token_for_medgemma
# JWT_SECRET_KEY=your_jwt_secret_here

# Environment
ENVIRONMENT=development
DEBUG=True

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173