# Database Configuration
DATABASE_URL=postgresql://oncosync:password@localhost:5432/oncosync

# Redis Configuration
REDIS_URL=redis://localhost:6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Vector Database
CHROMA_URL=http://localhost:8001

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Authentication (JWT)
JWT_SECRET=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# MedGemma Model Configuration
MEDGEMMA_CXR_MODEL_PATH=./models/medgemme-cxr
MEDGEMMA_TEXT_MODEL_PATH=./models/medgemme-text
MEDGEMMA_2B_MODEL_PATH=./models/medgemme-2b

# Logging
LOG_LEVEL=INFO
STRUCTLOG_PROCESSORS=json

# Privacy & Security
ENCRYPTION_KEY=your-encryption-key-here
DATA_RETENTION_DAYS=2555  # 7 years for medical data

# External APIs (for production)
HUGGINGFACE_API_KEY=your-huggingface-key
OPENAI_API_KEY=your-openai-key

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001